#!/usr/bin/env ruby
# frozen_string_literal: true

require 'digest'
require 'fileutils'
require 'json'
require 'net/http'
require 'open3'
require 'openssl'
require 'optparse'
require 'uri'

module FigmaSync
  BATCH_SIZE = 20
  RETRY_DELAYS = [5, 15, 45].freeze
  MAX_RETRY_AFTER = 120
  MAX_NAME_BYTES = 100
  FETCH_DEPTH = 4
  MANIFEST_NAME = '.figma-sync.json'
  ANNOTATIONS_SUFFIX = '.annotations.md'
  DRAWABLE_FORMATS = %w[png jpg].freeze
  CALLOUT = { width: 300, padding: 12, gap: 10, margin: 20, radius: 10, text_size: 15, line_spacing: 5, dot: 3,
              line: 1, dash: 4, border: 1 }.freeze
  CANVAS_COLOR = '#3C3C3C'
  CALLOUT_COLOR = '#2C2C2C'
  CALLOUT_BORDER_COLOR = '#4D4D4D'
  CALLOUT_TEXT_COLOR = '#F5F5F5'
  LEADER_COLOR = '#8C8C8C'
  LEADER_HALO_COLOR = '#FFFFFF99'
  FONTS = ['~/Library/Fonts/Inter-Regular.otf', '/Library/Fonts/Inter-Regular.otf',
           '/usr/share/fonts/opentype/inter/Inter-Regular.otf', '/System/Library/Fonts/Helvetica.ttc',
           '/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', '/usr/share/fonts/dejavu/DejaVuSans.ttf'].freeze
  MAGICK_REQUIRED = 'ImageMagick 7 is required to draw annotated images, but magick is not on PATH; ' \
                    'install it with: brew install imagemagick'
  MANIFEST_VERSION = 2
  SPLITTABLE_STATUSES = [400, 413, 500, 502, 503, 504].freeze
  MAX_HASH_FAILURES = 3
  KEYCHAIN_SERVICE = 'figma-token'
  FORMATS = %w[png svg jpg pdf].freeze
  SEPARATOR_PAGE = /\A[-[:space:]]*\z/
  URL_KEY = %r{figma\.com/(?:design|file)/([A-Za-z0-9]+)}
  NO_TOKEN = 'No Figma token. Set FIGMA_TOKEN, pass --token, or store one (security prompts for it): ' \
             'security add-generic-password -s figma-token -a "$USER" -U -w'
  MALFORMED_TOKEN = 'The Figma token contains whitespace, control or non-ASCII characters; store it again without them'

  class SyncError < StandardError
    attr_reader :status

    def initialize(message = nil, status: nil)
      super(message)
      @status = status
    end
  end

  class AuthError < SyncError; end

  class TransientError < SyncError
    attr_reader :retry_after

    def initialize(message, retry_after = nil, status: nil)
      super(message, status:)
      @retry_after = retry_after
    end
  end

  class << self
    def main(argv)
      options = parse_options(argv)
      sync(options)
    rescue SyncError, SystemCallError => e
      log("figma-sync: #{e.message}")
      1
    rescue Interrupt
      log('figma-sync: interrupted')
      130
    ensure
      Client.close_sessions
    end

    def sync(options)
      key = parse_file_key(options[:file])
      client = Client.new(resolve_token(options[:token]))
      raise SyncError, MAGICK_REQUIRED unless run_quiet(%w[magick -version])

      meta = client.get_file(key, depth: 1)
      out = options[:out] ? expand_user(options[:out]) : File.join(home_dir, 'Figma', sanitize(meta['name']))
      previous = File.exist?(out) ? load_manifest(out) : nil
      if previous && previous['fileKey'] != key
        raise SyncError, "#{display_path(out)} is synced from file #{previous['fileKey']}, not #{key}"
      end

      unchanged = previous &&
                  previous['version'] == meta['version'] &&
                  previous['format'] == options[:format] &&
                  previous['scale'] == options[:scale]
      if unchanged && !options[:force]
        puts "Up to date (version #{meta['version']})"
        return 0
      end

      log("Fetching #{meta['name']} (depth #{FETCH_DEPTH})...")
      data = client.get_file(key, depth: FETCH_DEPTH)
      pages = pages_with_frames(data['document'])
      current_ids = pages.flat_map { |_, frames| frames.map { _1[:id] } }.to_set
      previous_nodes = manifest_entries((previous || {}).fetch('nodes', {}))
      stale = previous_nodes.reject { |node_id, _| current_ids.include?(node_id) }.sort_by { |_, entry| entry['path'] }
      considered = limit_frames(pages, options[:limit])
      sections = considered.flat_map(&:last).to_h { [_1[:id], _1[:sections]] }
      digests = hash_frames(client, key, considered.flat_map(&:last))
      rerender = if options[:force] then '--force'
                 elsif previous && (previous['scale'] != options[:scale] || previous['format'] != options[:format])
                   'scale or format changed'
                 end
      plan = plan_frames(considered, previous_nodes, digests, out, options[:format], rerender)
      batches = make_batches(plan[:export_pages], options[:format])
      summary = plan_summary(plan, rerender)

      if options[:dry_run]
        puts "Output: #{display_path(out)}"
        print_plan(plan, batches, summary, stale.map { |_, entry| entry['path'] })
        return 0
      end

      log(summary)
      FileUtils.mkdir_p(out)
      nodes = previous_nodes.dup
      failed = []
      skipped = []
      unrenderable = []
      exported_count = 0
      removed = 0
      complete = false
      manifest = {
        'fileKey' => key,
        'manifestVersion' => MANIFEST_VERSION,
        'version' => nil,
        'lastModified' => data['lastModified'],
        'syncedAt' => nil,
        'scale' => options[:scale],
        'format' => options[:format],
        'nodes' => nodes
      }
      begin
        plan[:carry].each do |frame|
          move_file(out, frame[:old], frame[:rel]) if frame[:old] != frame[:rel]
          nodes[frame[:id]] = frame_entry(out, frame[:rel], digests[frame[:id]], nodes[frame[:id]],
                                          sections: frame[:sections], exported: false)
        end
        batches.each.with_index(1) do |(page_name, items), index|
          log("[#{index}/#{batches.size}] #{page_name.strip}: #{items.size} frames")
          result = export_batch(client, key, items, options[:format], options[:scale], out)
          result => { exported:, failed: batch_failed, skipped: batch_skipped, error: }
          exported.each do |node_id, rel|
            old = nodes.dig(node_id, 'path')
            if old && old != rel
              if same_file?(out, old, rel)
                match_case(out, rel)
              elsif remove_file(out, old) == :removed
                removed += 1
              end
            end
            nodes[node_id] = frame_entry(out, rel, digests[node_id], nodes[node_id],
                                         sections: sections[node_id], exported: true)
          end
          exported_count += exported.size
          skipped.concat(batch_skipped)
          batch_skipped.each do |node_id|
            next unless nodes.key?(node_id)

            unrenderable << nodes[node_id]['path'] if remove_file(out, nodes[node_id]['path']) == :removed
            remove_annotations(out, nodes.delete(node_id))
          end
          next if batch_failed.empty?

          log("    failed after retries: #{batch_failed.join(', ')} (#{error})")
          failed.concat(batch_failed)
        end
        stale.each do |node_id, entry|
          removed += 1 if remove_file(out, entry['path']) == :removed
          remove_annotations(out, entry)
          nodes.delete(node_id)
        end
        complete = true
      ensure
        manifest['syncedAt'] = Time.now.utc.strftime('%Y-%m-%dT%H:%M:%S+00:00')
        manifest['version'] = meta['version'] if complete && failed.empty? && options[:limit].nil?
        write_manifest(out, manifest)
      end

      log("Exported #{exported_count} frames to #{display_path(out)} (deleted #{removed} stale)")
      log("#{skipped.size} frame(s) rendered nothing and were skipped: #{skipped.join(', ')}") if skipped.any?
      unrenderable.each { log("    removed #{_1}") }
      unless failed.empty?
        log("#{failed.size} frame(s) failed: #{failed.join(', ')}")
        return 1
      end
      0
    end

    def export_batch(client, key, batch, fmt, scale, out)
      targets = batch.to_h
      begin
        urls = with_retries("#{targets.size} frame(s)") { client.image_urls(key, targets.keys, fmt:, scale:) }
      rescue AuthError
        raise
      rescue SyncError => e
        return { exported: {}, failed: targets.keys, skipped: [], error: e.message }
      end

      exported = {}
      failed = []
      skipped = []
      error = nil
      targets.each do |node_id, rel|
        url = urls[node_id]
        unless url
          skipped << node_id
          next
        end

        client.download(url, File.join(out, rel))
        exported[node_id] = rel
      rescue SyncError => e
        failed << node_id
        error = e.message
      end
      { exported:, failed:, skipped:, error: }
    end

    def with_retries(label, retry_if: nil)
      attempt = 0
      begin
        yield
      rescue TransientError => e
        raise if attempt == RETRY_DELAYS.size || (retry_if && !retry_if.call(e))

        delay = e.retry_after || RETRY_DELAYS[attempt]
        attempt += 1
        log("    retrying #{label} in #{delay}s (#{e.message})")
        sleep(delay)
        retry
      end
    end

    def parse_options(argv)
      options = { scale: 2.0, format: 'png', force: false, dry_run: false, limit: nil, out: nil, token: nil }
      usage = nil
      parser = OptionParser.new do |o|
        o.program_name = 'figma-sync'
        o.banner = 'usage: figma-sync [options] FILE'
        o.separator('')
        o.separator('Mirror every frame of a Figma file to a local folder, keeping it in sync on re-runs.')
        o.separator('')
        o.separator('FILE is a Figma file key or URL (https://www.figma.com/design/<key>/...)')
        o.separator('')
        o.on('--out DIR', 'output directory (default: ~/Figma/<file name>/)') { options[:out] = _1 }
        o.on('--scale N', Float, 'export scale, 0.01-4 (default: 2)') do |scale|
          raise OptionParser::InvalidArgument, "#{scale} (must be between 0.01 and 4)" unless scale.between?(0.01, 4)

          options[:scale] = scale
        end
        o.on('--format FORMAT', FORMATS, "image format: #{FORMATS.join(', ')} (default: png)") { options[:format] = _1 }
        o.on('--force', 'export even if the file version is unchanged') { options[:force] = true }
        o.on('--dry-run', 'show what would be exported/deleted; write nothing') { options[:dry_run] = true }
        o.on('--token TOKEN', 'Figma personal access token (default: $FIGMA_TOKEN, then the keychain)') do |token|
          options[:token] = token
        end
        o.on('-h', '--help', 'show this help and exit') do
          puts usage
          exit 0
        end
      end
      usage = parser.help
      parser.on('--limit N', Integer) do |limit|
        raise OptionParser::InvalidArgument, "#{limit} (must be >= 1)" if limit < 1

        options[:limit] = limit
      end

      begin
        rest = parser.parse(argv.map { utf8(_1) })
        raise OptionParser::MissingArgument, 'FILE' if rest.empty?
        raise OptionParser::NeedlessArgument, rest.drop(1).join(' ') if rest.size > 1
      rescue OptionParser::ParseError => e
        warn(usage)
        warn("figma-sync: #{e.message}")
        exit 2
      end
      options.merge(file: rest.first)
    end

    def log(msg)
      warn(msg)
    end

    def utf8(string)
      string.dup.force_encoding(Encoding::UTF_8)
    end

    def home_dir
      utf8(Dir.home)
    end

    def absolute_path(path, base = utf8(Dir.pwd))
      File.expand_path(path, base)
    end

    def expand_user(path)
      return path unless path.start_with?('~')
      return path.sub('~') { home_dir } if path == '~' || path.start_with?('~/')

      utf8(File.expand_path(path))
    end

    def display_path(path)
      home = home_dir
      path == home || path.start_with?(home + File::SEPARATOR) ? "~#{path[home.length..]}" : path
    end

    def run_quiet(cmd)
      stdout, _stderr, status = Open3.capture3(*cmd)
      status.success? ? utf8(stdout) : nil
    rescue Errno::ENOENT
      nil
    end

    def resolve_token(flag_token)
      token = token_text(flag_token)
      token = token_text(ENV.fetch('FIGMA_TOKEN', '')) if token.empty?
      token = token_text(run_quiet(['security', 'find-generic-password', '-s', KEYCHAIN_SERVICE, '-w'])) if token.empty?
      raise SyncError, NO_TOKEN if token.empty?
      raise SyncError, MALFORMED_TOKEN if !token.ascii_only? || token.match?(/[[:space:]]|[[:cntrl:]]/)

      token
    end

    def token_text(raw)
      text = utf8(raw.to_s)
      text.valid_encoding? ? text.strip : text
    end

    def parse_file_key(arg)
      match = URL_KEY.match(arg)
      return match[1] if match
      return arg if arg.match?(/\A[A-Za-z0-9]+\z/)

      raise SyncError, "cannot parse a Figma file key from #{arg.inspect}"
    end

    def sanitize(name, fallback = 'untitled')
      cleaned = name.tr('/:', '--').gsub(/[[:space:]]+/, ' ').sub(/\A[.[:space:]]+/, '').strip
      cleaned = cleaned.byteslice(0, MAX_NAME_BYTES).scrub('').strip if cleaned.bytesize > MAX_NAME_BYTES
      cleaned.empty? ? fallback : cleaned
    end

    def hidden?(node)
      node['visible'] == false || node['opacity']&.zero?
    end

    def collect_frames(node, page_name, frames, sections = [])
      node.fetch('children', []).each do |child|
        next if hidden?(child)

        case child['type']
        when 'FRAME'
          frames << { id: child['id'], name: child['name'], page: page_name, sections: }
        when 'SECTION'
          unless child.key?('children')
            log("warning: section #{child['name'].inspect} on #{page_name.inspect} is nested deeper than the " \
                "#{FETCH_DEPTH} levels fetched; its frames are not exported")
          end
          collect_frames(child, page_name, frames, [*sections, { id: child['id'], name: child['name'] }])
        end
      end
    end

    def pages_with_frames(document)
      document.fetch('children', []).filter_map do |page|
        next if page['type'] != 'CANVAS' || SEPARATOR_PAGE.match?(page['name'])

        frames = []
        collect_frames(page, page['name'], frames)
        [page['name'], frames]
      end
    end

    def relative_path(frame, fmt)
      node_suffix = frame[:id].tr(':', '-')
      "#{sanitize(frame[:page])}/#{sanitize(frame[:name])}__#{node_suffix}.#{fmt}"
    end

    def load_manifest(out)
      path = File.join(out, MANIFEST_NAME)
      return nil unless File.exist?(path)

      manifest = JSON.parse(File.read(path, encoding: Encoding::UTF_8))
      raise JSON::ParserError unless valid_manifest?(manifest)
      if manifest.fetch('manifestVersion', 1) > MANIFEST_VERSION
        raise SyncError, "#{display_path(path)} was written by a newer figma-sync (manifestVersion " \
                         "#{manifest['manifestVersion']}); upgrade this copy of the script"
      end

      manifest
    rescue JSON::ParserError
      raise SyncError, "#{display_path(path)} is not a valid figma-sync manifest; fix or delete it"
    end

    def valid_manifest?(manifest)
      return false unless manifest.is_a?(Hash)
      return false unless manifest.fetch('manifestVersion', 1).is_a?(Integer)

      nodes = manifest.fetch('nodes', {})
      nodes.is_a?(Hash) && nodes.values.all? { valid_entry?(_1) }
    end

    def valid_entry?(entry)
      return true if entry.is_a?(String)

      entry.is_a?(Hash) && entry['path'].is_a?(String) &&
        entry.values_at('hash', 'annotations', 'annotated').all? { _1.nil? || _1.is_a?(String) } &&
        valid_sections?(entry['sections'])
    end

    def valid_sections?(sections)
      sections.nil? ||
        (sections.is_a?(Array) && sections.all? { _1.is_a?(Hash) && _1.values_at('id', 'name').all?(String) })
    end

    def manifest_entries(nodes)
      nodes.transform_values do
        _1.is_a?(String) ? { 'path' => _1, 'hash' => nil } : _1.slice('path', 'hash', 'annotations', 'annotated', 'sections')
      end
    end

    def frame_entry(out, rel, digest, previous, sections:, exported:)
      previous ||= {}
      notes_changed = digest && notes_body(read_text(out, previous['annotations'])) != notes_body(digest[:annotations])
      annotations = sync_annotations(out, rel.sub(%r{\.[^./]+\z}, ANNOTATIONS_SUFFIX), digest, previous['annotations'])
      annotated = sync_annotated_image(out, rel, digest, previous['annotated'], redraw: exported || notes_changed)
      { 'path' => rel, 'hash' => digest&.fetch(:hash), 'annotations' => annotations, 'annotated' => annotated,
        'sections' => sections_entry(sections) }
        .reject { |name, value| value.nil? && name != 'hash' }
    end

    # valid_sections? accepts only strings, and a manifest it rejects costs a full re-export to replace.
    def sections_entry(sections)
      sections.map { { 'id' => _1[:id].to_s, 'name' => _1[:name].to_s } } if sections.any?
    end

    # Annotations are not in the hash, so they are rewritten from every frame hashed this run.
    # A frame that could not be hashed keeps the annotations file it had.
    def sync_annotations(out, rel, digest, old)
      return keep_annotations(out, rel, old) if digest.nil?

      markdown = digest[:annotations]
      remove_file(out, old) if old && (markdown.nil? || old != rel)
      return nil unless markdown

      write_text(out, rel, markdown)
      rel
    end

    def keep_annotations(out, rel, old)
      return nil unless old && file_present?(out, old)

      move_file(out, old, rel) if old != rel
      rel
    end

    # The annotated copy is drawn from the exported image, so it is redrawn whenever the image is
    # exported or the annotations change, and otherwise only moved along with the image.
    def sync_annotated_image(out, image_rel, digest, old, redraw:)
      rel = image_rel.sub(%r{(\.[^./]+)\z}, '.annotated\\1')
      drawing = digest && drawable?(rel) ? digest[:drawing] : nil
      return keep_annotations(out, rel, old) if digest.nil?

      return remove_annotated(out, old) unless drawing
      return keep_annotations(out, rel, old) if !redraw && old && file_present?(out, old)

      remove_file(out, old) if old && old != rel
      draw_annotations(contained_path(out, image_rel), contained_path(out, rel), drawing) ? rel : nil
    end

    def remove_annotated(out, old)
      remove_file(out, old) if old
      nil
    end

    def drawable?(rel)
      DRAWABLE_FORMATS.include?(File.extname(rel).delete_prefix('.'))
    end

    def draw_annotations(source, dest, drawing)
      size = run_quiet(['magick', 'identify', '-format', '%w %h', "#{source}[0]"])&.split&.map(&:to_i)
      return drawing_failed(source, 'cannot read the image') unless size&.size == 2

      font = annotation_font
      factor = drawing[:width] ? size.first.fdiv(drawing[:width]) : 1
      style = CALLOUT.transform_values { (_1 * factor).round }
      markers = drawing[:markers].map { |marker| marker.merge(box: marker[:box]&.map { (_1 * factor).round }) }
      texts = markers.map { _1[:text] }
      heights = run_quiet(callout_measure_command(texts, style, font))&.split&.map(&:to_i)
      return drawing_failed(source, 'cannot measure the notes') unless heights&.size == texts.size

      layout = callout_layout(markers, size, heights, style)
      _stdout, stderr, status = Open3.capture3(*callout_image_command(source, dest, layout, style, font))
      return true if status.success?

      FileUtils.rm_f(dest)
      drawing_failed(source, utf8(stderr).lines.first.to_s.strip)
    end

    # Figma draws annotations in Inter; the rest are fallbacks for machines without it.
    def annotation_font
      FONTS.map { expand_user(_1) }.find { File.exist?(_1) }
    end

    def drawing_failed(source, reason)
      log("warning: could not draw annotations on #{File.basename(source)} (#{reason})")
      false
    end

    # Like Figma's canvas: callouts sit in a gutter right of the frame, ordered top to bottom, each
    # centred on its layer when there is room, with a leader to the layer's right edge. Boxes are in pixels.
    def callout_layout(markers, size, heights, style)
      width, height = size
      left = width + style[:margin]
      bottom = style[:margin] - style[:gap]
      placed = markers.zip(heights).map do |marker, text_height|
        { marker:, box: marker[:box], height: text_height - style[:line_spacing] + (2 * style[:padding]) }
      end
      ordered = placed.each_with_index.sort_by do |item, index|
        [item[:box] ? item[:box][1] + (item[:box][3] / 2.0) - (item[:height] / 2.0) : Float::INFINITY, index]
      end
      callouts = ordered.map do |item, _|
        box = item[:box]
        desired = box ? box[1] + (box[3] / 2) - (item[:height] / 2) : bottom
        top = [desired, bottom + style[:gap]].max
        bottom = top + item[:height]
        middle = top + (item[:height] / 2)
        leader = box && [box[0] + box[2], middle.clamp(box[1], box[1] + box[3]), left, middle]
        { rect: [left, top, left + style[:width], bottom], text_at: [left + style[:padding], top + style[:padding]],
          text: item[:marker][:text], leader: }
      end
      { canvas: [left + style[:width] + style[:margin], [height, bottom + style[:margin]].max], callouts: }
    end

    def callout_measure_command(texts, style, font)
      ['magick', *(['-font', font] if font), '-pointsize', style[:text_size].to_s,
       '-interline-spacing', style[:line_spacing].to_s, '-size', "#{style[:width] - (2 * style[:padding])}x", *texts.map { "caption:#{magick_text(_1)}" },
       '-format', "%h\n", 'info:']
    end

    def callout_image_command(source, dest, layout, style, font)
      leaders = layout[:callouts].filter_map { _1[:leader] }.flat_map do |x1, y1, x2, y2|
        ['-fill', 'none', '-stroke', LEADER_HALO_COLOR, '-strokewidth', (style[:line] * 3).to_s,
         '-draw', "line #{x1},#{y1} #{x2},#{y2}",
         '-stroke', LEADER_COLOR, '-strokewidth', style[:line].to_s,
         '-draw', "stroke-dasharray #{style[:dash]} #{style[:dash]} line #{x1},#{y1} #{x2},#{y2}",
         '-fill', LEADER_COLOR, '-stroke', 'none', '-draw', "circle #{x1},#{y1} #{x1 + style[:dot]},#{y1}"]
      end
      callouts = layout[:callouts].flat_map do |callout|
        x1, y1, x2, y2 = callout[:rect]
        ['-fill', CALLOUT_COLOR, '-stroke', CALLOUT_BORDER_COLOR, '-strokewidth', style[:border].to_s,
         '-draw', "roundrectangle #{x1},#{y1} #{x2},#{y2} #{style[:radius]},#{style[:radius]}",
         '(', '-size', "#{style[:width] - (2 * style[:padding])}x", '-background', 'none', '-fill', CALLOUT_TEXT_COLOR, '-stroke', 'none',
         '-pointsize', style[:text_size].to_s, '-interline-spacing', style[:line_spacing].to_s, "caption:#{magick_text(callout[:text])}", ')',
         '-geometry', "+#{callout[:text_at][0]}+#{callout[:text_at][1]}", '-composite']
      end
      ['magick', source, *(['-font', font] if font), '-background', CANVAS_COLOR, '-gravity', 'NorthWest',
       '-extent', layout[:canvas].join('x'), *leaders, *callouts, dest]
    end

    # ImageMagick expands % escapes and backslash sequences in caption text.
    def magick_text(text)
      text.gsub('\\', '\\\\\\\\').gsub('%', '%%')
    end

    def remove_annotations(out, entry)
      entry.values_at('annotations', 'annotated').compact.each { remove_file(out, _1) }
    end

    # The title is the frame name, which the annotated copy does not show.
    def notes_body(markdown)
      markdown&.sub(/\A# .*\n/, '')
    end

    def read_text(out, rel)
      path = rel && contained_path(out, rel)
      path && File.file?(path) ? File.read(path, encoding: Encoding::UTF_8) : nil
    end

    def write_text(out, rel, text)
      path = contained_path(out, rel)
      return if File.file?(path) && File.read(path, encoding: Encoding::UTF_8) == text

      FileUtils.mkdir_p(File.dirname(path))
      File.write(path, text, encoding: Encoding::UTF_8)
    end

    def write_manifest(out, manifest)
      tmp = File.join(out, "#{MANIFEST_NAME}.tmp")
      File.write(tmp, "#{JSON.pretty_generate(manifest)}\n", encoding: Encoding::UTF_8)
      File.rename(tmp, File.join(out, MANIFEST_NAME))
    end

    def make_batches(pages, fmt)
      pages.flat_map do |page_name, frames|
        frames.each_slice(BATCH_SIZE).map { |chunk| [page_name, chunk.map { [_1[:id], relative_path(_1, fmt)] }] }
      end
    end

    def limit_frames(pages, limit)
      return pages if limit.nil?

      remaining = limit
      pages.filter_map do |page_name, frames|
        next if remaining.zero?

        taken = frames.first(remaining)
        remaining -= taken.size
        [page_name, taken]
      end
    end

    def hash_frames(client, key, frames)
      chunks = frames.map { _1[:id] }.each_slice(BATCH_SIZE).to_a
      log("Hashing #{frames.size} frames in #{chunks.size} requests...") if chunks.any?
      state = { failures: 0, skipped: 0 }
      hashes = chunks.each.with_index(1).with_object({}) do |(ids, index), result|
        skipped_before = state[:skipped]
        chunk = chunk_hashes(client, key, ids, state)
        result.merge!(chunk)
        next if state[:skipped] - skipped_before == ids.size

        hashed = ids.count { chunk[_1]&.fetch(:hash) }
        log("  [#{index}/#{chunks.size}] hashed #{hashed == ids.size ? hashed : "#{hashed} of #{ids.size}"} frames")
      end
      if state[:skipped].positive?
        log("warning: stopped hashing after #{MAX_HASH_FAILURES} failed requests; " \
            "#{state[:skipped]} remaining frame(s) will be exported without a hash")
      end
      hashes
    end

    # A frame that cannot be hashed gets a nil hash, which counts as changed, so a request Figma
    # keeps refusing costs an export instead of stopping the sync. Only rate limiting stops the
    # run: exporting instead would spend image requests while Figma is already refusing calls.
    # A multi-frame request that fails is split at once rather than retried, and the backoff
    # retries are spent only on single frames; after MAX_HASH_FAILURES fallbacks the remaining
    # frames are not requested at all, so a /nodes outage costs minutes, not hours.
    def chunk_hashes(client, key, ids, state)
      if state[:failures] >= MAX_HASH_FAILURES
        state[:skipped] += ids.size
        return ids.to_h { [_1, nil] }
      end

      retry_if = ids.size > 1 ? ->(e) { e.status == 429 } : nil
      documents = with_retries("#{ids.size} node(s)", retry_if:) { client.node_documents(key, ids) }
      documents.transform_values { frame_digest(_1) }
    rescue AuthError
      raise
    rescue SyncError => e
      if e.status == 429
        raise SyncError, "Figma is rate limiting frame hashing (#{e.message}); stopped without changing anything, " \
                         'the next run will retry'
      end
      if ids.size > 1 && splittable?(e)
        half = ids.size.fdiv(2).ceil
        return chunk_hashes(client, key, ids.first(half), state).merge(chunk_hashes(client, key, ids.drop(half), state))
      end

      state[:failures] += 1
      log("warning: could not hash #{ids.join(', ')} (#{e.message}); exporting them without a hash")
      ids.to_h { [_1, nil] }
    end

    def frame_digest(document)
      document && { hash: content_hash(document), annotations: annotations_markdown(document),
                    drawing: annotation_drawing(document) }
    end

    def splittable?(error)
      SPLITTABLE_STATUSES.include?(error.status) || error.cause.is_a?(Net::ReadTimeout)
    end

    # The root's name is excluded so that renaming a frame moves its file instead of re-rendering it,
    # and annotations are excluded because Figma does not render them.
    def content_hash(document)
      document && Digest::SHA256.hexdigest(JSON.generate(canonical(document.except('name')), max_nesting: false))
    end

    def canonical(value)
      case value
      when Hash then (value.keys - ['annotations']).sort.to_h { |k| [k, canonical(value[k])] }
      when Array then value.map { canonical(_1) }
      else value
      end
    end

    def annotations_markdown(document)
      sections = annotated_nodes(document).map do |node|
        notes = node['annotations'].map { annotation_text(_1) }.reject(&:empty?)
        "## #{node['name']} (#{node['id']})\n\n#{notes.join("\n\n")}\n"
      end
      sections.empty? ? nil : "# #{document['name']}\n\n#{sections.join("\n")}"
    end

    # Boxes are in design units relative to the frame's render bounds, the area the exported image covers.
    def annotation_drawing(document)
      nodes = annotated_nodes(document)
      return nil if nodes.empty?

      origin = document['absoluteRenderBounds'] || document['absoluteBoundingBox'] || {}
      markers = nodes.map do |node|
        bounds = node['absoluteBoundingBox']
        box = bounds && [bounds['x'] - origin['x'], bounds['y'] - origin['y'], bounds['width'], bounds['height']]
        text = node['annotations'].map { annotation_text(_1, markdown: false) }.reject(&:empty?).join("\n")
        { box:, text: }
      end
      { width: origin['width'], markers: }
    end

    def annotated_nodes(node, found = [])
      return found if hidden?(node)

      found << node if node['annotations']&.any?
      node.fetch('children', []).each { annotated_nodes(_1, found) }
      found
    end

    def annotation_text(annotation, markdown: true)
      properties = annotation.fetch('properties', []).map { _1['type'] }
      label = markdown ? annotation['labelMarkdown'] || annotation['label'] : annotation['label']
      [label, ("Properties: #{properties.join(', ')}" if properties.any?)].compact.join(markdown ? "\n\n" : "\n")
    end

    def plan_frames(pages, entries, digests, out, fmt, rerender)
      plan = { new: [], changed: [], unchanged: [] }
      export_pages = pages.map do |page_name, frames|
        exporting = frames.select do |frame|
          entry = entries[frame[:id]]
          item = frame.merge(rel: relative_path(frame, fmt), hash: digests[frame[:id]]&.fetch(:hash),
                             old: entry&.fetch('path'), old_sections: entry&.[]('sections'))
          status = frame_status(entry, item[:hash], out)
          plan[status] << item
          rerender || status != :unchanged
        end
        [page_name, exporting]
      end
      plan.merge(export_pages:, carry: rerender ? [] : plan[:unchanged])
    end

    def frame_status(entry, hash, out)
      return :new if entry.nil?
      return :changed if hash.nil? || entry['hash'] != hash || !file_present?(out, entry['path'])

      :unchanged
    end

    def plan_summary(plan, rerender)
      counts = %i[changed new unchanged].map { "#{plan[_1].size} #{_1}" }.join(', ')
      total = plan.values_at(:new, :changed, :unchanged).sum(&:size)
      "#{total} frames: #{counts}#{"; re-exporting all (#{rerender})" if rerender}"
    end

    def contained_path(out, rel)
      return nil if rel.start_with?('~')

      root = absolute_path(out)
      path = absolute_path(rel, root)
      path.start_with?("#{root}/") ? path : nil
    end

    def same_file?(out, rel_a, rel_b)
      path_a = contained_path(out, rel_a)
      path_b = contained_path(out, rel_b)
      !path_a.nil? && !path_b.nil? && File.identical?(path_a, path_b)
    end

    def match_case(out, rel)
      parent = absolute_path(out)
      rel.split('/').each do |part|
        actual = Dir.children(parent, encoding: Encoding::UTF_8).find { _1 != part && _1.casecmp?(part) }
        if actual
          tmp = File.join(parent, ".figma-sync-case-#{Process.pid}")
          File.rename(File.join(parent, actual), tmp)
          File.rename(tmp, File.join(parent, part))
        end
        parent = File.join(parent, part)
      end
    rescue SystemCallError => e
      log("warning: could not update the capitalisation of #{rel.inspect}: #{e.message}")
    end

    def remove_file(out, rel)
      root = absolute_path(out)
      path = contained_path(root, rel)
      unless path
        log("warning: not deleting #{rel.inspect}; it is outside #{display_path(out)}")
        return :unsafe
      end
      return :absent unless File.file?(path)

      File.unlink(path)
      prune_empty_dirs(root, File.dirname(path))
      :removed
    end

    def move_file(out, old_rel, new_rel)
      return match_case(out, new_rel) if same_file?(out, old_rel, new_rel)

      from = contained_path(out, old_rel)
      to = contained_path(out, new_rel)
      FileUtils.mkdir_p(File.dirname(to))
      File.rename(from, to)
      prune_empty_dirs(absolute_path(out), File.dirname(from))
    end

    def prune_empty_dirs(root, parent)
      while parent.start_with?("#{root}/") && Dir.empty?(parent)
        Dir.rmdir(parent)
        parent = File.dirname(parent)
      end
    end

    def file_present?(out, rel)
      path = contained_path(out, rel)
      !path.nil? && File.file?(path)
    end

    def section_chain(sections)
      sections ? sections.map { _1['name'] }.join(' / ') : '(none)'
    end

    def print_plan(plan, batches, summary, stale)
      items = %i[new changed unchanged].flat_map { |status| plan[status].map { [_1[:id], _1.merge(status:)] } }.to_h
      exporting = batches.flat_map { |_, batch| batch.map { items.fetch(_1.first) } }
      renames = plan[:carry].reject { _1[:old] == _1[:rel] }
      regrouped = plan[:carry].reject { _1[:old_sections] == sections_entry(_1[:sections]) }
      superseded = exporting.count { _1[:old] && _1[:old] != _1[:rel] }
      puts summary
      puts "Would export #{exporting.size} frames in #{batches.size} batches"
      exporting.each { puts "  #{_1[:rel]}  (#{_1[:status]})" }
      puts "Would rename #{renames.size} unchanged file(s)" if renames.any?
      renames.each { puts "  - #{_1[:old]}  ->  #{_1[:rel]}" }
      puts "Would update the sections of #{regrouped.size} unchanged frame(s)" if regrouped.any?
      regrouped.each do |frame|
        puts "  #{frame[:rel]}: sections #{section_chain(frame[:old_sections])} -> #{section_chain(sections_entry(frame[:sections]))}"
      end
      puts "Would delete #{stale.size} stale file(s) for removed frames" +
           (superseded.positive? ? ", plus up to #{superseded} superseded by renamed paths" : '')
      stale.each { puts "  - #{_1}" }
    end
  end

  class Client
    API_BASE = 'https://api.figma.com'
    OPEN_TIMEOUT = 30
    READ_TIMEOUT = 120
    MAX_REDIRECTS = 5
    KEEP_ALIVE_TIMEOUT = 30
    NETWORK_ERRORS = [SocketError, Timeout::Error, EOFError, IOError, SystemCallError, OpenSSL::SSL::SSLError].freeze

    def self.sessions
      @sessions ||= {}
    end

    def self.close_sessions
      sessions.each_value { |http| http.finish if http.started? }
      sessions.clear
    end

    def initialize(token)
      @headers = { 'X-Figma-Token' => token }
    end

    def get_file(key, depth:)
      FigmaSync.with_retries("file #{key}") { api_get("/v1/files/#{key}", depth:) }
    end

    def node_documents(key, ids)
      body = api_get("/v1/files/#{key}/nodes", ids: ids.join(','), geometry: 'paths')
      (body['nodes'] || {}).transform_values { _1&.fetch('document', nil) }
    end

    def image_urls(key, ids, fmt:, scale:)
      body = api_get("/v1/images/#{key}", ids: ids.join(','), format: fmt, scale: format('%g', scale))
      raise SyncError, "images request failed: #{body['err']}" if body['err']

      body['images'] || {}
    end

    def download(url, dest)
      tmp = File.join(File.dirname(dest), ".#{File.basename(dest)}.part")
      local_io { FileUtils.mkdir_p(File.dirname(dest)) }
      FigmaSync.with_retries("download #{File.basename(dest)}") { fetch_to(URI(url), tmp) }
      local_io { File.rename(tmp, dest) }
    ensure
      FileUtils.rm_f(tmp)
    end

    private

    def local_io
      yield
    rescue SystemCallError => e
      raise SyncError, e.message
    end

    def api_get(path, **params)
      uri = URI("#{API_BASE}#{path}")
      uri.query = URI.encode_www_form(params)
      response = request(uri, @headers)
      check_api(response, path)
      JSON.parse(FigmaSync.utf8(response.body), max_nesting: false)
    rescue JSON::ParserError
      raise SyncError, "GET #{path} returned non-JSON output"
    end

    def check_api(response, path)
      return if response.is_a?(Net::HTTPSuccess)

      detail = error_detail(response)
      if response.code == '403'
        raise AuthError, "Figma API returned HTTP 403#{detail}: the token is invalid or lacks access to this file"
      end

      raise status_error(response, "GET #{path}", detail)
    end

    def fetch_to(uri, path, redirects = MAX_REDIRECTS)
      location = nil
      request(uri) do |response|
        case response
        when Net::HTTPSuccess then write_body(response, path)
        when Net::HTTPRedirection then location = response['location']
        else raise status_error(response, "download from #{uri.host}")
        end
      end
      return unless location
      raise SyncError, "too many redirects downloading from #{uri.host}" if redirects.zero?

      fetch_to(URI.join(uri.to_s, location), path, redirects - 1)
    end

    def write_body(response, path)
      file = local_io { File.open(path, 'wb') }
      begin
        response.read_body { |chunk| local_io { file.write(chunk) } }
      ensure
        local_io { file.close }
      end
    end

    def request(uri, headers = {}, &)
      session(uri).request(Net::HTTP::Get.new(uri, headers), &)
    rescue *NETWORK_ERRORS => e
      raise TransientError, "#{uri.host}: #{e.message} (#{e.class})"
    end

    def session(uri)
      self.class.sessions[[uri.scheme, uri.host, uri.port]] ||=
        Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https', open_timeout: OPEN_TIMEOUT,
                                            read_timeout: READ_TIMEOUT, keep_alive_timeout: KEEP_ALIVE_TIMEOUT)
    end

    def status_error(response, label, detail = '')
      message = "#{label} returned HTTP #{response.code}#{detail}"
      code = response.code.to_i
      return TransientError.new(message, retry_after(response), status: code) if code == 429
      return TransientError.new(message, status: code) if code >= 500

      SyncError.new(message, status: code)
    end

    def retry_after(response)
      value = response['retry-after']
      seconds = value&.match?(/\A\d+\z/) ? value.to_i : 0
      seconds.positive? ? [seconds, FigmaSync::MAX_RETRY_AFTER].min : nil
    end

    def error_detail(response)
      body = JSON.parse(FigmaSync.utf8(response.body.to_s))
      detail = body['err'] || body['message'] if body.is_a?(Hash)
      detail ? " (#{detail})" : ''
    rescue JSON::ParserError
      ''
    end
  end
end

exit(FigmaSync.main(ARGV)) if $PROGRAM_NAME == __FILE__
